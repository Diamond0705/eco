DEBUG=True
SECRET_KEY=change-me-for-local-development
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DATABASE_URL=postgres://ecologist:ecologist@localhost:5432/ecologist
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
LOG_LEVEL=INFO
DJANGO_SERVER_LOG_LEVEL=INFO
ROUTE_PROVIDER=graphhopper
CALCULATION_MODEL=v2.1
MAX_ROUTE_DISTANCE_KM=2000
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
GRAPHHOPPER_PROFILE=car
GRAPHHOPPER_TIMEOUT_SECONDS=10
GRAPHHOPPER_FALLBACK_TO_MOCK=False
GRAPHHOPPER_ALTERNATIVE_MAX_PATHS=5
GRAPHHOPPER_ALTERNATIVE_MAX_WEIGHT_FACTOR=1.6
GRAPHHOPPER_ALTERNATIVE_MAX_SHARE_FACTOR=0.7
GRAPHHOPPER_TARGET_CANDIDATES=3
GRAPHHOPPER_MAX_CANDIDATES=5
GRAPHHOPPER_ENABLE_STRATEGY_REQUESTS=False
GRAPHHOPPER_MAX_STRATEGY_REQUESTS=2
GRAPHHOPPER_ENABLE_PATH_DETAILS=True
GRAPHHOPPER_PATH_DETAILS=road_class,road_environment,surface,max_speed,toll
USE_S3_STORAGE=False
DOCUMENT_ARCHIVE_ENABLED=True
AWS_ACCESS_KEY_ID=ecologist
AWS_SECRET_ACCESS_KEY=ecologist-password
AWS_STORAGE_BUCKET_NAME=ecologist-documents
# Local runserver uses localhost. docker-compose.deploy.yml overrides this to http://minio:9000.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
